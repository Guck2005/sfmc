{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "datasource", "uid": "grafana" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Golden Signals — Overview",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "id": 100
    },
    {
      "title": "Request rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "targets": [
        {
          "expr": "sum by (app) (rate(http_requests_total[5m]))",
          "legendFormat": "{{app}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "title": "Error rate (5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "sum by (app) (rate(http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "{{app}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "title": "Latency p95 (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, app) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{app}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "CPU / Memory saturation",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 4,
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"sfmc\"}[5m]))",
          "legendFormat": "cpu {{pod}}",
          "refId": "A"
        },
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"sfmc\"}) / 1024 / 1024",
          "legendFormat": "mem MiB {{pod}}",
          "refId": "B"
        }
      ]
    },
    {
      "title": "RabbitMQ — Queues",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false,
      "id": 200
    },
    {
      "title": "DLQ backlog (sfmc.dlq)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 18 },
      "id": 5,
      "targets": [
        {
          "expr": "rabbitmq_queue_messages_ready{queue=\"sfmc.dlq\"}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "Messages ready (per queue)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 18 },
      "id": 6,
      "targets": [
        {
          "expr": "rabbitmq_queue_messages_ready",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Message publish / deliver rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "id": 7,
      "targets": [
        {
          "expr": "sum by (queue) (rate(rabbitmq_queue_messages_published_total[5m]))",
          "legendFormat": "publish {{queue}}",
          "refId": "A"
        },
        {
          "expr": "sum by (queue) (rate(rabbitmq_queue_messages_delivered_total[5m]))",
          "legendFormat": "deliver {{queue}}",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Unacked messages",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "id": 8,
      "targets": [
        {
          "expr": "rabbitmq_queue_messages_unacknowledged",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["sfmc"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "SFMC Bénin — Plateforme microservices",
  "uid": "sfmc-overview",
  "version": 1,
  "weekStart": ""
}
