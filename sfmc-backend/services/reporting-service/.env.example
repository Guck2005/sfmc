TZ=UTC
PORT=3009
HOST=localhost
LOG_LEVEL=info
APP_KEY=replace-with-a-32-char-app-key
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=5439
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=sfmc_reporting
DB_SSL=false

# Même secret que auth-service pour valider les JWT Bearer (ADMIN / OPERATOR).
JWT_SECRET=dev-secret-change-me-32-characters-minimum

# OpenTelemetry (optional — leave empty to disable)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAMESPACE=sfmc
