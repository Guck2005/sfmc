TZ=UTC
PORT=3005
HOST=localhost
LOG_LEVEL=info
APP_KEY=replace-with-a-32-char-app-key
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=5435
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=sfmc_order
DB_SSL=false
JWT_SECRET=change-me-to-a-256-bit-random-secret
RABBITMQ_URL=amqp://guest:guest@localhost:5672
INVENTORY_SERVICE_URL=http://localhost:3004
PRODUCT_SERVICE_URL=http://localhost:3003
USER_SERVICE_URL=http://localhost:3002

# --- Paiement avant validation commande (mobile money) ---
# true = après stock OK, la commande attend la confirmation PSP (webhook signé) avant order.validated.
REQUIRE_PAYMENT_BEFORE_VALIDATION=false
# @deprecated : si true, équivalent à REQUIRE_PAYMENT_BEFORE_VALIDATION=true
MOBILE_MONEY_STUB_ENABLED=false
# Secret partagé avec le PSP : signature HMAC sur POST /api/v1/webhooks/mobile-money
PAYMENT_WEBHOOK_SECRET=
# true = autorise POST /api/v1/orders/:id/mobile-money/complete-local (développement uniquement)
ALLOW_PAYMENT_COMPLETE_LOCAL=true
# URL du prestataire pour futurs appels HTTP sortants (Wave, OM, etc.)
MOBILE_MONEY_PSP_BASE_URL=

# OpenTelemetry (optional — leave empty to disable)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAMESPACE=sfmc
