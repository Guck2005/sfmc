TZ=UTC
PORT=3007
HOST=localhost
LOG_LEVEL=info
APP_KEY=replace-with-a-32-char-app-key
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=5437
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=sfmc_billing
DB_SSL=false

# JWT (doit correspondre à celui d'auth-service — même secret partagé)
JWT_SECRET=change-me-in-production-same-as-auth-service

# OpenTelemetry (optional — leave empty to disable)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAMESPACE=sfmc
